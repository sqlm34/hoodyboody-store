{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "env": {
    "SITE_ORIGIN": "https://byirishka.com"
  },
  "functions": {
    "server.js": {
      "maxDuration": 30,
      "includeFiles": "{*.html,*.css,*.js,robots.txt,assets/**,content/**,controllers/**,models/**,routes/**,services/**,dist/**,package.json}"
    },
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{*.html,*.css,*.js,robots.txt,assets/**,content/**,controllers/**,models/**,routes/**,services/**,dist/**,package.json}"
    }
  }
}
