{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "server.js": {
      "maxDuration": 30,
      "includeFiles": "{*.html,*.css,*.js,assets/**,package.json}"
    },
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{*.html,*.css,*.js,assets/**,package.json}"
    }
  }
}
