{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "{*.html,*.css,*.js,robots.txt,assets/**,content/**,controllers/**,models/**,routes/**,services/**,dist/**,package.json}"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      },
      "dest": "server.js"
    }
  ],
  "env": {
    "SITE_ORIGIN": "https://byirishka.com"
  }
}
